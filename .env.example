# ── 服务器 ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1          # 本地用 127.0.0.1；服务器部署用 0.0.0.0
PORT=3000
APP_BASE_URL=           # 对外可访问的完整地址（飞书 OAuth 回调、机器人提示登录用），如 https://kb.yourco.com

# ── 飞书自建应用（每个部署者用「自己企业」的应用，切勿使用他人的 app 凭证）───────────
# 到 open.feishu.cn 创建自建应用，拿到 App ID / App Secret 填这里。个人也可先「创建团队」再建应用。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_PATH=/api/auth/feishu/callback
FEISHU_VERIFICATION_TOKEN=      # 事件订阅校验用（配了机器人才需要）
# 单租户自建应用的兼容兜底。OAuth 已返回 tenant_key 时系统优先使用真实 tenant_key；
# 老会话/本地桩没有 tenant_key 时用此值，避免组织数据落到 app:local。
FEISHU_TENANT_KEY=
# 已有生产环境的首次迁移引导名单（逗号分隔 open_id）：第一个成为 Owner，其余为管理员。
# 组织建立后请在右上角「组织管理」维护角色；新部署未配置时，同租户首位登录者成为 Owner。
ADMIN_OPEN_IDS=

# ── LLM Key 模型：每个用户在「设置」里填自己的 key（存各自会话，绝不外传前端）────────
# 下面这些是「默认兜底 key」，仅供你本地/内网测试用。
# ⚠️ 对外部署 / 开源：全部留空！留空后每个用户必须填自己的 key（系统会在其发起提问时按需提醒），
#    这样你自己的 key 不会被别人消耗。
DEFAULT_LLM_PROVIDER=glm        # 默认厂商（仅当下方默认 key 有值时生效）
DEFAULT_LLM_KEY=                # 默认聊天/嵌入 key —— 对外部署务必留空
GLM_API_KEY=                    # 各厂商默认 key（同样仅测试用，对外留空）
KIMI_API_KEY=
AGNES_API_KEY=

# ── 本机 MinerU（PDF → 结构化 Markdown；文件不出本机）───────────────────────────
# 先运行：npm run mineru:install && npm run mineru:start
# 服务只监听 127.0.0.1；Node 侧同样拒绝连接非本机地址。
MINERU_ENABLED=true
MINERU_API_URL=http://127.0.0.1:18000
# M4/MPS 推荐 hybrid-engine + medium；high 更准但明显更慢。
MINERU_BACKEND=hybrid-engine
MINERU_EFFORT=medium
MINERU_TIMEOUT_MS=300000
MINERU_MAX_MD_CHARS=5000000

# ── 通用 OCR 兜底（非 PDF 图片，或未启用 MinerU 时的扫描件）─────────────────────
# 留空只影响图片/扫描件；普通文本、Office 和文本型 PDF 仍可解析。
OCR_API_URL=
OCR_API_KEY=
# 本地 PDF.js 文本解析的页数保护上限，防止异常大文件长时间占用服务进程。
PDF_MAX_PAGES=500

# ── 其它 ───────────────────────────────────────────────────────────────────────
LARK_CLI_PATH=                  # lark-cli 可执行文件路径（留空则用 PATH）
USE_MOCK=false                  # true = 全程用假数据，便于纯前端联调
DEV_STUB_LOGIN=false            # true = 本地免飞书登录的开发桩（生产务必 false）
# LLM 查询规划/法官等“决策缓存”有效期（毫秒）。默认 0=关闭；有金标对照后再显式开启。
# 最终答案与生产检索结果始终不缓存。
LLM_DECISION_CACHE_TTL_MS=0
# 仅用于准确率回归：1 表示本进程不读写查询规划/法官等模型决策缓存。生产保持 0。
LLM_DECISION_CACHE_BYPASS=0
# 相关性法官每批候选数；默认 8，并行分批，不裁剪候选。
LLM_JUDGE_BATCH_SIZE=8
