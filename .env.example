# ── 应用服务 ───────────────────────────────────────────────────────────────────
# 本机启动默认只监听回环地址；对外部署请配合防火墙与 HTTPS 反向代理。
HOST=127.0.0.1
PORT=3000
# OAuth 回调与机器人登录提示使用的完整外部地址；必须和飞书后台登记一致。
APP_BASE_URL=http://127.0.0.1:3000
# Docker 模式映射到宿主机的端口，容器内部仍使用 3000。
FEISHU_BRAIN_HOST_PORT=3000

# ── 飞书自建应用（必填）────────────────────────────────────────────────────────
# 在 https://open.feishu.cn/app 创建企业自建应用后填写。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_PATH=/api/auth/feishu/callback
# 可选：覆盖代码内置的 OAuth scope 列表，使用空格分隔。
FEISHU_SCOPES=
# 仅事件订阅/机器人需要。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 旧会话或本地测试没有 tenant_key 时的兼容兜底。
FEISHU_TENANT_KEY=
# 首次迁移引导名单，逗号分隔 open_id；首位为 Owner，其余为管理员。
ADMIN_OPEN_IDS=

# ── 模型服务 ───────────────────────────────────────────────────────────────────
# 用户可在页面右上角设置自己的 Base URL、模型与 API Key。
# 以下只是在服务端提供默认兜底；对外部署建议将 DEFAULT_LLM_KEY 留空。
DEFAULT_LLM_PROVIDER=bailian
DEFAULT_LLM_KEY=

# ── 可选：本机 MinerU（PDF 结构化解析）──────────────────────────────────────────
# MinerU 不随本仓库分发；未启用时文本型 PDF 使用 pdfjs-dist。
MINERU_ENABLED=false
MINERU_API_URL=http://127.0.0.1:18000
MINERU_BACKEND=hybrid-engine
MINERU_EFFORT=medium
MINERU_TIMEOUT_MS=300000
MINERU_MAX_MD_CHARS=5000000

# ── 可选：图片/扫描件 OCR ──────────────────────────────────────────────────────
OCR_API_URL=
OCR_API_KEY=
PDF_MAX_PAGES=500

# ── 检索质量与诊断 ─────────────────────────────────────────────────────────────
# 0 表示不缓存查询规划、法官等模型决策；最终答案不作为命中缓存复用。
LLM_DECISION_CACHE_TTL_MS=0
LLM_DECISION_CACHE_BYPASS=0
LLM_JUDGE_BATCH_SIZE=8
# 仅排障时设为 1，会在服务日志输出阶段耗时。
RAG_TIMING=0
