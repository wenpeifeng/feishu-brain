# Server bind address (use 127.0.0.1 for local, 0.0.0.0 for server deploy)
HOST=127.0.0.1

# Server port
PORT=3000

 # Feishu app credentials (optional; can also be configured in the UI; when set, the app writes them to a project-local lark-cli home directory)
 FEISHU_APP_ID=
 FEISHU_APP_SECRET=

# Path to lark-cli binary (leave empty to use PATH)
LARK_CLI_PATH=

# Lark identity: user or bot
LARK_IDENTITY=user

# OpenAI-compatible LLM config (optional; without it the service returns content excerpts)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM provider: openai, moonshot, custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Set to true to always use mock data, useful for UI development without real Feishu calls
USE_MOCK=false
