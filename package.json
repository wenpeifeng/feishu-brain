{
  "name": "feishu-brain",
  "version": "1.0.0",
  "description": "飞书大脑（Feishu Brain）—— 按登录人飞书权限检索资料、结合自建知识库生成带证据回答的单机 RAG Web 应用",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node test/api.test.js",
    "test:all": "node scripts/test-all.js",
    "service:start": "bash script/sh/start-all.sh",
    "service:status": "bash script/sh/status-all.sh",
    "service:stop": "bash script/sh/stop-all.sh",
    "mineru:install": "bash script/sh/mineru-local.sh install",
    "mineru:start": "bash script/sh/mineru-local.sh start",
    "mineru:stop": "bash script/sh/mineru-local.sh stop",
    "mineru:status": "bash script/sh/mineru-local.sh status",
    "mineru:logs": "bash script/sh/mineru-local.sh logs"
  },
  "keywords": [
    "feishu",
    "lark",
    "rag",
    "knowledge-base",
    "knowledge-management",
    "llm",
    "ai",
    "qa",
    "chatbot",
    "enterprise-search"
  ],
  "author": "wenpeifeng",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "4.2.67"
  }
}
